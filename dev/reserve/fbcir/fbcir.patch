+#' Backward influence duration from a one-lag table (internal)
+#'
+#' The FBCIR family reducer behind `aci_range(direction = "backward")`.
+#'
+#' @param x A `lag_table` built with `mode = "one_lag"`.
+#' @param method Either `"exact"` or `"l1_linf"`.
+#' @param epsilon Optional finite non-negative reporting thresholds.
+#' @param min_M Either `"auto"` or one finite non-negative number.
+#' @param masked_value Either `"na"` or `"zero"`.
+#' @param quadrature Either `"sum"` (eq. G.14) or `"simpson"`.
+#' @param simpson_close Even-grid Simpson closing convention.
+#' @param ... Unused; supplying anything is an error.
+#' @returns An object of class `cir_result` with `direction` `"backward"`.
+#' @noRd
+.aci_range_backward_table <- function(x, method = c("exact", "l1_linf"),
+                                      epsilon = NULL, min_M = "auto",
+                                      masked_value = c("na", "zero"),
+                                      quadrature = c("sum", "simpson"),
+                                      simpson_close = c("quadratic",
+                                                        "trapezoid"),
+                                      ...) {
+  if (length(list(...)))
+    aci_abort("aci_error_dims", "Unused arguments were supplied to aci_range().")
+  masked_value <- match.arg(masked_value)
+  quadrature <- match.arg(quadrature)
+  simpson_close <- match.arg(simpson_close)
+  method <- match.arg(method)
+  if (!inherits(x, "lag_table"))
+    aci_abort("aci_error_dims", "x must be a lag_table.")
+  P <- lt_onelag(x)
+  r <- .bwd_lengths(P, x$dt, method, quadrature, simpson_close)
+  ## andreou2026cir Section 2.3.4 validity gate: causal intensity at the
+  ## T - dt end of the grid versus the initial-time information deficit
+  ## P^0_T (eq. 21; Remark C.2).  The gate is a diagnostic beside tau and M,
+  ## not a change to the centred metric.
+  baseline <- unname(P[1L])
+  terminal <- unname(P[length(P)])
+  Tend <- x$t[length(x$t)]
