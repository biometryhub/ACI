+  subj <- NULL
+  if (!is.null(epsilon)) {
+    if (!is.numeric(epsilon) || !length(epsilon) || any(!is.finite(epsilon)) || any(epsilon < 0))
+      aci_abort("aci_error_dims", "epsilon must contain finite non-negative thresholds.")
+    cc <- abs(P - P[1]); pt <- x$t[seq_along(P)]
