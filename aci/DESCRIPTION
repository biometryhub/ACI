Package: aci
Type: Package
Title: Assimilative Causal Inference for Stochastic Dynamical Systems
Version: 0.0.30
Authors@R: c(
    person("Aidan", "Moller", role = c("aut", "cre", "cph"),
           email = "aidan.moller@adelaide.edu.au"),
    person("Marios", "Andreou", role = "cph",
